{
  "name": "pmail",
  "productName": "Pmail",
  "version": "1.0.0",
  "description": "Cliente de correo nativo offline-first para PC con dominios @pac.p y @pacur.p",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis",
    "test:smtp": "node test/testSmtp.js",
    "engine:demo": "node src/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pac.pmail",
    "productName": "Pmail",
    "copyright": "Copyright © 2026 Pmail Team",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pmail"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.exe"
    }
  },
  "author": "Pmail Team",
  "license": "MIT"
}
